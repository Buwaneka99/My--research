# ============================================================
# DeepSentinel — VAE-With-DSAA .gitignore
# R26-IT-121 | IT22109194 | Wijesinghe L P D B
# ============================================================

# Redundant .py versions (notebooks are the source of truth)
*.py

# Proposal / spec PDFs are kept (each < 1 MB).
# Personal documents are not part of the research.
MY CV/

# Data files (too large for GitHub — stored in Google Drive)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv

# Saved models and results (too large — stored in Google Drive)
results/*
models/*
!results/.gitkeep
!models/.gitkeep
*.keras
*.h5
*.pkl
*.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# ─── DeepSentinel-VAE-Results ──────────────────────────────────────────
# Keep the artefacts that make the results reproducible/reviewable
# (~20 MB total). The 11 feature-dump CSVs (~1.86 GB) stay ignored via
# the *.csv rule above and in the root .gitignore — they live in Drive.
# Negations must come last: the final matching pattern wins.
!DeepSentinel-VAE-Results/**/*.png
!DeepSentinel-VAE-Results/**/*.json
!DeepSentinel-VAE-Results/**/*.keras
!DeepSentinel-VAE-Results/**/*.h5
!DeepSentinel-VAE-Results/**/*.pkl
!DeepSentinel-VAE-Results/**/*.npz
